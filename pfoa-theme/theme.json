{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#302d2b",
          "name": "Ink",
          "slug": "ink"
        },
        {
          "color": "#77716c",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#ffffff",
          "name": "Canvas",
          "slug": "canvas"
        },
        {
          "color": "#ebe7dd",
          "name": "Surface",
          "slug": "surface"
        },
        {
          "color": "#211e1d",
          "name": "Header",
          "slug": "header"
        },
        {
          "color": "#934244",
          "name": "Brand",
          "slug": "brand"
        },
        {
          "color": "#e9ad4e",
          "name": "Accent",
          "slug": "accent"
        },
        {
          "color": "#e5e0da",
          "name": "Rule",
          "slug": "rule"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1280px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "name": "Small",
          "size": "0.5rem",
          "slug": "10"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "20"
        },
        {
          "name": "Large",
          "size": "2rem",
          "slug": "40"
        },
        {
          "name": "Extra large",
          "size": "4rem",
          "slug": "80"
        }
      ],
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "System Sans",
          "slug": "body"
        },
        {
          "fontFamily": "Georgia, \"Times New Roman\", serif",
          "name": "Display Serif",
          "slug": "display"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.5rem",
          "slug": "large"
        },
        {
          "name": "Extra large",
          "size": "clamp(2.25rem, 4vw, 3.75rem)",
          "slug": "x-large"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|ink"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|ink"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700",
          "lineHeight": "1.1"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|brand"
        }
      }
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    }
  }
}
