{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#302d2b",
          "name": "Primary text",
          "slug": "text"
        },
        {
          "color": "#6f6963",
          "name": "Muted text",
          "slug": "muted"
        },
        {
          "color": "#ffffff",
          "name": "Canvas white",
          "slug": "background"
        },
        {
          "color": "#ebe7dd",
          "name": "Outer neutral",
          "slug": "outer"
        },
        {
          "color": "#211e1d",
          "name": "Warm charcoal",
          "slug": "charcoal"
        },
        {
          "color": "#934244",
          "name": "Brick brand",
          "slug": "brand"
        },
        {
          "color": "#e9ad4e",
          "name": "Warm gold",
          "slug": "gold"
        },
        {
          "color": "#e5e0da",
          "name": "Rule",
          "slug": "border"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1280px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "name": "XS",
          "size": "8px",
          "slug": "space-1"
        },
        {
          "name": "S",
          "size": "12px",
          "slug": "space-2"
        },
        {
          "name": "M",
          "size": "16px",
          "slug": "space-3"
        },
        {
          "name": "L",
          "size": "24px",
          "slug": "space-4"
        },
        {
          "name": "XL",
          "size": "32px",
          "slug": "space-5"
        },
        {
          "name": "2XL",
          "size": "48px",
          "slug": "space-6"
        },
        {
          "name": "3XL",
          "size": "64px",
          "slug": "space-7"
        },
        {
          "name": "4XL",
          "size": "80px",
          "slug": "space-8"
        }
      ],
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "System Sans",
          "slug": "body"
        },
        {
          "fontFamily": "Georgia, \"Times New Roman\", serif",
          "name": "Display Serif",
          "slug": "display"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Body",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.5rem",
          "slug": "large"
        },
        {
          "name": "Display",
          "size": "clamp(2.25rem, 4vw, 3.75rem)",
          "slug": "x-large"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "elements": {
      "button": {
        "border": {
          "color": "var:preset|color|text",
          "radius": "5px",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var:preset|color|gold",
          "text": "var:preset|color|text"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|brand"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    },
    "spacing": {
      "blockGap": "var:preset|spacing|space-4"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    }
  }
}
